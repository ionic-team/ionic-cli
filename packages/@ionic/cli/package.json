    "elementtree": "^0.1.7",
    "leek": "0.0.24",
    "lodash": "^4.17.5",
    "open": "^7.0.4",
    "os-name": "^4.0.0",
    "proxy-agent": "^6.3.0",
    "semver": "^7.1.1",
    "split2": "^3.0.0",
    "ssh-config": "^1.1.1",
    "stream-combiner2": "^1.1.1",
    "superagent": "^9.0.2",
    "tar": "^6.0.1",
    "tslib": "^2.8.1"
